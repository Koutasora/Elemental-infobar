{
  "name": "elemental-infobar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node20 --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outfile=com.elemental.infobar.sdPlugin/bin/plugin.js",
    "typecheck": "tsc",
    "restart": "powershell -NoProfile -File restart.ps1",
    "deploy": "npm run build && npm run restart"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "*",
    "@types/node": "*",
    "esbuild": "*",
    "opentype.js": "^2.0.0",
    "typescript": "*"
  }
}
